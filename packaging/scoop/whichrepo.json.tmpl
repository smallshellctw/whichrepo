{
  "version": "{{VERSION}}",
  "description": "Find the right repository for a task and show the evidence",
  "homepage": "https://github.com/smallshellctw/whichrepo",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/smallshellctw/whichrepo/releases/download/v{{VERSION}}/whichrepo_{{VERSION}}_windows_amd64.zip",
      "hash": "{{WINDOWS_AMD64_SHA256}}"
    },
    "arm64": {
      "url": "https://github.com/smallshellctw/whichrepo/releases/download/v{{VERSION}}/whichrepo_{{VERSION}}_windows_arm64.zip",
      "hash": "{{WINDOWS_ARM64_SHA256}}"
    }
  },
  "bin": "whichrepo.exe",
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": { "url": "https://github.com/smallshellctw/whichrepo/releases/download/v$version/whichrepo_$version_windows_amd64.zip" },
      "arm64": { "url": "https://github.com/smallshellctw/whichrepo/releases/download/v$version/whichrepo_$version_windows_arm64.zip" }
    }
  }
}

